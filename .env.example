# OpenAGI environment configuration.
# Copy to .env or .openagi/.env and fill in. The daemon loads both.

# --- Model provider ---
# Per project rule: default to GPT-5 family.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Reasoning depth, for models that support it: minimal | low | medium | high.
# Unset by default — sending `reasoning` to a model that doesn't take it is a
# 400, so this stays opt-in rather than becoming a floor for every model.
# OPENAI_REASONING_EFFORT=high
# Optional override:
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional speech-to-text overrides used by enrolled Even Realities G2 nodes.
# Defaults: OPENAI_BASE_URL and gpt-4o-mini-transcribe.
# OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional live G2 speech. Server only, never a VITE variable.
# A standard speech-enabled key works through the main's streaming relay.
# Only optional direct-to-Deepgram mode needs Member permission to mint tokens.
# DEEPGRAM_API_KEY=

# NOTE on provider selection: OPENAGI_PROVIDER=auto prefers Anthropic whenever
# ANTHROPIC_API_KEY is set, so OPENAI_MODEL is ignored on a machine that has
# both keys. Set OPENAGI_PROVIDER=openai to force the OpenAI model to be used.

# --- Model tiering (optional, opt-in) ---
# One base model (above) handles chat + autopilot. The small, frequent
# background jobs don't need it — point them at cheaper models and save.
# Run `openagi models` to see the plan and what's still on the base model.
#   mini → scheduled reminders, memory condensing, session mining, daily recap
#   nano → proactive observer, scrutiny judges (short + very frequent)
# OPENAI_MODEL_MINI=gpt-5-mini
# OPENAI_MODEL_NANO=gpt-5-nano
# Pin a single job to an exact model (wins over its tier). Jobs:
# OBSERVER, SCRUTINY, CONDENSE, MINE, PLAN, EXTRACT, SWEEP, CHAT, AUTOPILOT, SCHEDULED
# OPENAI_MODEL_TASK_OBSERVER=gpt-5-nano
# Example: keep your selected foreground OPENAI_MODEL, use Luna for background work:
# OPENAI_MODEL_MINI=gpt-5.6-luna
# OPENAI_MODEL_NANO=gpt-5.6-luna
# OPENAI_MODEL_TASK_AUTOPILOT=gpt-5.6-luna
# OPENAI_MODEL_TASK_SCHEDULED=gpt-5.6-luna
# Reasoning effort for a single job (wins over OPENAI_REASONING_EFFORT), same job names.
# One of none/minimal/low/medium/high/xhigh; anything else is ignored with a warning.
# OPENAI_REASONING_EFFORT_TASK_CHAT=high

# --- Twilio (SMS) ---
# Inbound: configure your Twilio phone number to POST messages to
#   https://<your-public-host>/channels/twilio/webhook
# Outbound (proactive sends, scheduled prompts that ping by SMS) needs:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Where the agent should text you proactively (your phone):
DEFAULT_SMS_TARGET=

# --- Telegram ---
# Create a bot via BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=
# Set to "1" to long-poll Telegram on startup. Leave blank if you'll register
# a webhook to /channels/telegram/webhook instead.
TELEGRAM_POLLING=

# --- Rize.io (time tracking) ---
# Generate an API key in Rize Settings → API Keys.
# Tools surfaced to the agent: rize_query (raw GraphQL), rize_today_summary, rize_recent_sessions.
RIZE_API_KEY=

# --- Web search ---
# Set at least one key to enable the web_search tool. With no key set, web_search
# returns a "no provider configured" error; fetch_url still works via plain HTTP.
# Auto-selection priority: exa -> tavily -> brave -> serpapi -> firecrawl -> perplexity
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
BRAVE_API_KEY=
PERPLEXITY_API_KEY=
SERPAPI_API_KEY=
# Google Custom Search alternative (requires both):
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Force a specific provider (exa|tavily|firecrawl|brave|perplexity|serpapi).
# Leave blank to let the agent auto-select.
WEB_SEARCH_PROVIDER=

# --- BuildBetter ---
# Ingest mode: signals (default, action items -> tasks), transcripts (call
# transcripts -> searchable memory via recall_activity), or both.
BUILDBETTER_API_KEY=
BUILDBETTER_USER_EMAIL=
BUILDBETTER_USER_NAME=
BUILDBETTER_WEBHOOK_SECRET=
BUILDBETTER_INGEST_MODE=

# --- Voice Supervisor (hub) ---
# 1 opens WSS /nodes/voice: Mac (owner token), phone and G2 talk to the fleet
# through one gpt-realtime session per device. The OpenAI key stays on the hub.
OPENAGI_VOICE=
# Realtime model. A -mini model is never used (its tool calls are unreliable).
OPENAGI_VOICE_MODEL=gpt-realtime-2.1
# Daily voice spend cap (USD, ledger channel "voice"); a session ends at it.
OPENAGI_VOICE_DAILY_USD=5

# --- Budget cap ---
# Hard daily ceiling (USD). Provider calls throw BUDGET_EXCEEDED past this.
OPENAGI_DAILY_USD_LIMIT=10
# Per-turn ceiling (USD, all tool hops of one reply). Past it the tool loop
# stops and the agent says so; say "continue" to go on. 0 disables. Default 2.
# Skill tools that call the model count toward the same turn total.
# OPENAGI_TURN_USD_LIMIT=2
# Per-call input cap for OpenAI and Anthropic (estimated tokens). Older tool
# outputs, then older chat turns, are trimmed to fit. If protected input still
# exceeds the cap, the call is rejected before sending. Default 60000.
# Spend-stop replies retain bounded tool arguments/results for "continue".
# OPENAGI_MAX_INPUT_TOKENS=60000

# --- Auth (recommended once tunneled) ---
# Set to a strong random string; generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# When unset, the dashboard runs unauthenticated (local-only is OK; tunneled is not).
OPENAGI_AUTH_TOKEN=

# Optional external coding-supervisor adapter (trusted local modules only).
# Leave empty to use the built-in supervisor, enabled from More > Coding Agents.
# See docs/setup/coding-supervisor.md for fresh-install setup and permission limits.
OPENAGI_CODING_SUPERVISOR_DIR=
OPENAGI_CODING_SUPERVISOR_STATE_FILE=
# Main-to-node coding supervisor routing (optional enrolled node ID).
OPENAGI_CODING_SUPERVISOR_NODE=

# Exact public HTTPS origin for webhooks and G2 Agents URL/token provisioning
# (e.g. https://openagi.example.com). Required for Twilio signature checks when
# behind a tunnel and before Nodes can generate a G2 agent URL + scoped token.
OPENAGI_PUBLIC_URL=

# Experimental per-Mac Open Computer Use engine; native remains the default.
# Install: node scripts/install-open-computer-use.mjs --install
# OPENAGI_COMPUTER_BACKEND=open-computer-use
# OPENAGI_OCU_PATH=/absolute/path/to/OpenComputerUse

# Telegram webhook: shared secret. Set the same value when calling setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# --- Daemon ---
HOST=127.0.0.1
PORT=43210
# Optional override for where config/state live. Leave UNSET for the stable
# default (~/.openagi). Only set this to an ABSOLUTE path (e.g. /data); a
# relative value would make state depend on the launch directory.
# OPENAGI_DATA_DIR=/absolute/path
# Background ticker (ms). Set to 0 to disable; the runtime.tick() will then
# only run on POST /tick.
OPENAGI_TICKER_MS=10000
# Fast semantic workflow-learning pass. Default 60 minutes; values below 15
# are ignored to keep local scans/model proposal costs bounded. The nightly
# deep pass remains enabled for day/week trend validation.
# OPENAGI_PATTERN_MINE_INTERVAL_MIN=60
# Optional IANA timezone used for hourly/daily/weekly cadence inference.
# Defaults to the daemon's local timezone.
# OPENAGI_TIME_ZONE=America/Los_Angeles

# Optional Vocaleo phone-call tool. Prefer Integrations → Vocaleo to verify
# your own phone number and save the one-time API key privately.
# VOCALEO_API_KEY=<your-vocaleo-api-key>
# VOCALEO_ACCOUNT_ID=
# VOCALEO_PHONE_NUMBER=+14155550123

# Models never to use, whatever a tier, task pin or caller asks for
# (comma-separated; a trailing * matches a prefix). A denied model runs as the
# provider's own fallback (OPENAI_MODEL_DENY_FALLBACK / ANTHROPIC_MODEL_DENY_FALLBACK)
# instead, or the base model when that is allowed.
# OPENAGI_MODEL_DENY=gpt-6-astra*
# OPENAI_MODEL_DENY_FALLBACK=gpt-6.1-sol
